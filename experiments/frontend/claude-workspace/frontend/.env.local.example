# Override default ports/URLs as needed.
# Backend Anserini REST server URL (server-side env, used by API routes)
ANSERINI_BASE_URL=http://localhost:8080
# Prebuilt index name to query
ANSERINI_INDEX=msmarco-v1-passage
# Path to MS MARCO passage dev queries JSON (produced by scripts/fetch-dev-queries.sh)
SAMPLE_QUERIES_PATH=./data/msmarco-passage-dev-queries.json
# How many sample queries to surface per page load
SAMPLE_QUERIES_COUNT=6
# Frontend port (used by `next dev`/`next start`)
PORT=3000
