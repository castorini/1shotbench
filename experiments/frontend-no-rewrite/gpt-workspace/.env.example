# Backend REST API port (default: 8080)
ANSERINI_BACKEND_PORT=8080

# Optional explicit backend URL. If unset, the frontend uses http://localhost:$ANSERINI_BACKEND_PORT.
# ANSERINI_BACKEND_URL=http://localhost:8080

# Frontend port (default: 3000)
FRONTEND_PORT=3000

# Downloaded Anserini fatjar. The default package script uses ./anserini-2.1.1-fatjar.jar.
ANSERINI_JAR=./anserini-2.1.1-fatjar.jar

# Search index served by Anserini (default: msmarco-v1-passage)
ANSERINI_INDEX=msmarco-v1-passage
