esulting score.\\n- Display sufficient run metadata for debugging, including the selected index, selected topics, qrels/evaluation source, metric, status, elapsed time, generated run file path, and evaluation output path or preview.\\n- Handle missing Java, missing fatjar, unsupported index/topic pairings,","index":1}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M3","usage":{"input":0,"output":0,"cacheRead":4909,"cacheWrite":0,"totalTokens":4909,"cost":{"input":0,"output":0,"cacheRead":0.00058908,"cacheWrite":0,"total":0.00058908}},"stopReason":"stop","timestamp":1780721204130,"responseId":"0672d934531e45780fc4ca93c5ca1cde"}}
