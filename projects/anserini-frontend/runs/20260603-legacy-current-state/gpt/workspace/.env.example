# Frontend port used by npm run dev and npm start.
FRONTEND_PORT=3000

# Anserini REST backend. npm run backend binds this port by default.
ANSERINI_PORT=8080
ANSERINI_BIND_HOST=0.0.0.0

# Next.js API proxy settings.
# If ANSERINI_API_URL is set, it takes precedence over ANSERINI_HOST/ANSERINI_PORT.
ANSERINI_HOST=localhost
ANSERINI_INDEX=msmarco-v1-passage
# ANSERINI_API_URL=http://localhost:8080

# Path to the downloaded Anserini fatjar. Optional if the jar is in the repo root.
ANSERINI_JAR=./anserini-2.1.1-fatjar.jar
